#!/bin/bash

# ==============================================================================
# Script Interactivo de Automatización: Generador de Proyectos ASP.NET Minimal API
# ==============================================================================

set -e

GREEN='\033[0;32m'
CYAN='\033[0;36m'
YELLOW='\033[1;33m'
BOLD='\033[1m'
NC='\033[0m'

echo -e "${CYAN}${BOLD}"
echo "================================================================"
echo "   🚀 Generador Automático de Proyectos ASP.NET Minimal API     "
echo "================================================================"
echo -e "${NC}"

# 1. Obtener el nombre del proyecto
PROJECT_NAME="$1"
if [ -z "$PROJECT_NAME" ]; then
    read -p "📌 Ingresa el nombre del nuevo proyecto (ej. FacturacionApi): " PROJECT_NAME
fi

if [ -z "$PROJECT_NAME" ]; then
    echo -e "${YELLOW}❌ Error: Debes ingresar un nombre para el proyecto.${NC}"
    exit 1
fi

# 2. Selección de Base de Datos
echo ""
echo -e "${BOLD}🗄️  Selecciona la Base de Datos a utilizar:${NC}"
echo "  1) Ambas (MySQL + SQL Server)"
echo "  2) Solo MySQL"
echo "  3) Solo SQL Server"
read -p "Elige una opción (1-3) [Por defecto 1]: " DB_OPTION

DB_OPTION=${DB_OPTION:-1}

# 3. Selección de Autenticación y Autorización (JWT + BCrypt)
echo ""
echo -e "${BOLD}🔐 ¿Deseas incluir Autenticación JWT y Autorización con BCrypt?${NC}"
echo "  1) Sí (JwtBearer + BCrypt.Net-Next + Swagger Auth preconfigurado)"
echo "  2) No (API sin autenticación)"
read -p "Elige una opción (1-2) [Por defecto 1]: " AUTH_OPTION

AUTH_OPTION=${AUTH_OPTION:-1}

echo ""
echo -e "${CYAN}🔨 Generando proyecto '$PROJECT_NAME' con la plantilla 'minimal-api'...${NC}"

# 4. Crear proyecto con dotnet new minimal-api
dotnet new minimal-api -n "$PROJECT_NAME"

cd "$PROJECT_NAME"

# 5. Configuración de Base de Datos
CLEAN_NAME=$(echo "$PROJECT_NAME" | sed -E 's/(Api|DB|ApiDB|DbAPI|db|api)//gI' | tr '[:upper:]' '[:lower:]')
if [ -z "$CLEAN_NAME" ]; then
    CLEAN_NAME="my"
fi
DB_NAME="${CLEAN_NAME}db"

if [ -f "docker/mysql/init.sql" ]; then
    sed -i '' "s/mydb/$DB_NAME/g" docker/mysql/init.sql 2>/dev/null || sed -i "s/mydb/$DB_NAME/g" docker/mysql/init.sql
fi

if [ -f "appsettings.json" ]; then
    sed -i '' "s/mydb/$DB_NAME/g" appsettings.json 2>/dev/null || sed -i "s/mydb/$DB_NAME/g" appsettings.json
fi

case $DB_OPTION in
    2)
        echo -e "${CYAN}⚙️ Configurando solo conector MySQL (Base de datos: $DB_NAME)...${NC}"
        ;;
    3)
        echo -e "${CYAN}⚙️ Configurando solo conector SQL Server (Base de datos: $DB_NAME)...${NC}"
        ;;
    *)
        echo -e "${CYAN}⚙️ Configurando conectores para MySQL y SQL Server (Base de datos: $DB_NAME)...${NC}"
        ;;
esac

# 6. Configuración opcional de Autenticación y Autorización (JWT + BCrypt)
AUTH_INSTALLED=false
if [ "$AUTH_OPTION" = "1" ] || [ "$AUTH_OPTION" = "s" ] || [ "$AUTH_OPTION" = "S" ] || [ "$AUTH_OPTION" = "y" ] || [ "$AUTH_OPTION" = "Y" ]; then
    AUTH_INSTALLED=true
    echo -e "${CYAN}🔐 Instalando paquetes de Autenticación JWT y BCrypt...${NC}"
    dotnet add package Microsoft.AspNetCore.Authentication.JwtBearer > /dev/null
    dotnet add package BCrypt.Net-Next > /dev/null

    echo -e "${CYAN}⚙️ Configurando appsettings.json con JwtSettings...${NC}"
    cat << EOF > appsettings.json
{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "JwtSettings": {
    "SecretKey": "SuperSecretKey_MustBeLongEnough12345_ChangeMeInProduction!",
    "Issuer": "${PROJECT_NAME}",
    "Audience": "${PROJECT_NAME}Client",
    "ExpiryMinutes": 120
  },
  "ConnectionStrings": {
    "MySqlConnection": "Server=localhost;Database=${DB_NAME};Uid=root;Pwd=root_password;",
    "SqlServerConnection": "Server=localhost;Database=${DB_NAME};User Id=sa;Password=Password123!;TrustServerCertificate=True;"
  }
}
EOF

    echo -e "${CYAN}⚙️ Configurando Program.cs con JWT, Auth Repositories, Services y Endpoints...${NC}"
    cat << EOF > Program.cs
using System.Text;
using FluentValidation;
using Microsoft.AspNetCore.Authentication.JwtBearer;
using Microsoft.IdentityModel.Tokens;
using Microsoft.OpenApi.Models;
using ${PROJECT_NAME}.Endpoints;
using ${PROJECT_NAME}.Middleware;
using ${PROJECT_NAME}.Repositories;
using ${PROJECT_NAME}.Services;

var builder = WebApplication.CreateBuilder(args);

// 1. Swagger / OpenAPI Configuration with Bearer Auth
builder.Services.AddEndpointsApiExplorer();
builder.Services.AddSwaggerGen(options =>
{
    options.AddSecurityDefinition("Bearer", new OpenApiSecurityScheme
    {
        Name = "Authorization",
        Type = SecuritySchemeType.Http,
        Scheme = "bearer",
        BearerFormat = "JWT",
        In = ParameterLocation.Header,
        Description = "Ingrese únicamente el Token JWT devuelto por el /api/auth/login"
    });

    options.AddSecurityRequirement(new OpenApiSecurityRequirement
    {
        {
            new OpenApiSecurityScheme
            {
                Reference = new OpenApiReference
                {
                    Type = ReferenceType.SecurityScheme,
                    Id = "Bearer"
                }
            },
            Array.Empty<string>()
        }
    });
});

// 2. Global Exception Handling & ProblemDetails
builder.Services.AddExceptionHandler<GlobalExceptionHandler>();
builder.Services.AddProblemDetails();

// 3. FluentValidation Auto-Registration
builder.Services.AddValidatorsFromAssemblyContaining<Program>();

// 4. JWT Authentication, Authorization, Repositories & Services
builder.Services.AddScoped<IAuthRepository, AuthRepository>();
builder.Services.AddScoped<IJwtService, JwtServices>();
builder.Services.AddScoped<IAuthServices, AuthServices>();

builder.Services.AddAuthentication(JwtBearerDefaults.AuthenticationScheme)
    .AddJwtBearer(options =>
    {
        options.TokenValidationParameters = new TokenValidationParameters
        {
            ValidateIssuer = true,
            ValidateAudience = true,
            ValidateLifetime = true,
            ValidateIssuerSigningKey = true,
            ValidIssuer = builder.Configuration["JwtSettings:Issuer"] ?? "${PROJECT_NAME}",
            ValidAudience = builder.Configuration["JwtSettings:Audience"] ?? "${PROJECT_NAME}Client",
            IssuerSigningKey = new SymmetricSecurityKey(
                Encoding.UTF8.GetBytes(builder.Configuration["JwtSettings:SecretKey"] ?? "SuperSecretKey_MustBeLongEnough12345_ChangeMeInProduction!"))
        };
    });

builder.Services.AddAuthorization();

// 5. CORS Policy
builder.Services.AddCors(options =>
{
    options.AddPolicy("AllowAll", policy =>
    {
        policy.SetIsOriginAllowed(_ => true)
              .AllowAnyHeader()
              .AllowAnyMethod();
    });
});

var app = builder.Build();

app.UseCors("AllowAll");
app.UseExceptionHandler();

// Enable Authentication & Authorization
app.UseAuthentication();
app.UseAuthorization();

// Enable Swagger UI by default
app.UseSwagger();
app.UseSwaggerUI(c =>
{
    c.SwaggerEndpoint("/swagger/v1/swagger.json", "API v1");
    c.RoutePrefix = "swagger";
});

// Redirect root "/" to "/swagger"
app.MapGet("/", () => Results.Redirect("/swagger")).ExcludeFromDescription();

// Map Endpoints
app.MapHealthEndpoints();
app.MapAuthEndpoints();

app.Run();
EOF

fi

echo ""
echo -e "${GREEN}${BOLD}✨ ¡Proyecto '$PROJECT_NAME' generado con éxito!${NC}"
echo "----------------------------------------------------------------"
echo -e "📁 Carpetas creadas: ${CYAN}Common, Middleware, Endpoints, Dtos, Models, Services, Repositories, Validations${NC}"
echo -e "🧱 Componentes listos: ${CYAN}Result.cs, ResultExtensions.cs, GlobalExceptionHandler.cs, ValidationFilter.cs${NC}"
if [ "$AUTH_INSTALLED" = true ]; then
    echo -e "🔐 Autenticación & Autorización: ${CYAN}JwtBearer, BCrypt.Net-Next y Swagger Bearer Auth (CONFIGURADOS)${NC}"
else
    echo -e "🔐 Autenticación & Autorización: ${CYAN}No incluida (API pública)${NC}"
fi
echo -e "📦 Paquetes NuGet: ${CYAN}Dapper, FluentValidation, MySqlConnector, SqlClient, Swashbuckle${NC}"
echo -e "🐳 Infraestructura: ${CYAN}Dockerfile y docker-compose.yml preconfigurados${NC}"
echo "----------------------------------------------------------------"
echo -e "${BOLD}Comandos para comenzar:${NC}"
echo -e "  cd $PROJECT_NAME"
echo -e "  dotnet run               # Iniciar en local (http://localhost:5000/swagger)"
echo -e "  docker compose up -d     # Iniciar con contenedores Docker"
echo ""
